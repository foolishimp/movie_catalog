# Copy to .env and fill in your values

# Postgres (matches docker-compose defaults)
DATABASE_URL=postgresql://catalog:catalog@localhost:5432/media_catalog

# TMDb API key — get one free at https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_tmdb_api_key_here

# OMDb API key — get one free at https://www.omdbapi.com/apikey.aspx
OMDB_API_KEY=your_omdb_api_key_here

# Directories to scan (colon-separated)
MEDIA_DIRS=/path/to/movies:/path/to/series:/another/path

# Ebook folders for the Books tab (colon-separated). Calibre libraries inside
# them are read as a starting point; files are indexed independently.
BOOK_DIRS=/Volumes/Library/Books:/Volumes/Archive/calibre

# Name of the folder holding game books, whose credits are always read.
#GAME_BOOK_FOLDER=rpg

# Path mappings for LAN clients ("Copy path" buttons) — JSON object mapping a
# server-local prefix to its smb:// URL and Windows UNC forms.
# In JSON, \\\\ is a literal double backslash (UNC prefix).
#PATH_MAPPINGS={"/Volumes/Library": {"smb": "smb://nas/Library", "unc": "\\\\nas\\Library"}, "/Volumes/Archive": {"smb": "smb://nas/Archive", "unc": "\\\\nas\\Archive"}}

# Video file extensions to match
VIDEO_EXTENSIONS=.mkv,.mp4,.avi,.m4v,.wmv,.flv,.mov,.ts,.webm,.mpg,.mpeg,.divx,.ogm,.iso,.img

# Network volumes to mount on demand when a path under them is missing.
#NETWORK_MOUNTS=/Volumes/Library=smb://nas/Library:/Volumes/Archive=smb://nas/Archive
